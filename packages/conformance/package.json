{
  "name": "codemcp-conformance",
  "version": "0.3.0",
  "description": "Hostile-script conformance suite every codemcp executor must pass.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackunseen/codemcp.git",
    "directory": "packages/conformance"
  },
  "homepage": "https://github.com/stackunseen/codemcp#readme",
  "bugs": {
    "url": "https://github.com/stackunseen/codemcp/issues"
  },
